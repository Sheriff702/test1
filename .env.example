# Admin login. Pick something strong before deploying.
ADMIN_PASSWORD=mares-admin

# Signs the admin session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-random-32-byte-hex-string

# --- Cloudflare D1 (database) ---------------------------------------------
# Leave blank to use a local SQLite file at ./data/mares.db (dev/VPS only).
# In production on Vercel, set these three and the app talks to D1 over HTTP.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
# Cloudflare API token with D1:edit on the target database
CLOUDFLARE_D1_API_TOKEN=

# Optional: override the local file location when not using D1
# DB_PATH=/var/lib/mares/mares.db

# --- Cloudflare R2 (image uploads) ----------------------------------------
# Without these, the admin upload button falls back to ./public/uploads/
# (which only works on dev/VPS, not on Vercel).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mares-uploads
# Public-facing URL for the bucket. Either the workers.dev/r2.dev public URL
# or a custom domain you've routed to the bucket. No trailing slash.
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
